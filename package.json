{
  "name": "beyond-money",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run db:push && npm run seed -- --if-empty && next start",
    "lint": "eslint",
    "db:push": "mkdir -p \"$(dirname \"${DATABASE_PATH:-./data/app.db}\")\" && drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:backup": "tsx scripts/backup.ts",
    "vapid": "tsx scripts/vapid.ts",
    "seed": "tsx scripts/seed.ts",
    "edge:build": "tsx scripts/build-edge.ts",
    "edge:dev": "wrangler dev --config edge/wrangler.jsonc",
    "edge:deploy": "wrangler deploy --config edge/wrangler.jsonc",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.126.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260825.1": true
  }
}
