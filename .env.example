# Copy to .env.local. Nothing here is required locally — every variable has a
# working default, except GEMINI_API_KEY, without which the assistant replies
# with a configuration hint instead of calling the API.

# SQLite file. On a container host, must point into a persistent volume.
DATABASE_PATH=./data/app.db

# Public origin, for Open Graph tags. Read at BUILD time.
NEXT_PUBLIC_SITE_URL=https://beyond-money.example.com

# Demo account `npm run seed` imports into, and where it reads .csv exports.
# A SEED_EMAIL you change must already exist — the seed will not create it.
# SEED_EMAIL=you@example.com
# SEED_NAME=Jeanine
# SEED_PASSWORD=something-only-you-know   # default is public; set on deploys
# SEED_DIR=./scripts/seed-data

# Where `npm run db:backup` writes. Default: `backups/` beside the database.
# BACKUP_DIR=./data/backups

# Web push notifications. Optional — without a keypair the account page's
# notification row says push is not configured and offers no button. Generate
# one with `npm run vapid`, then keep it: every subscription a browser hands
# out is bound to the public key it was created with, so a new pair silently
# unsubscribes every device. The public key is NOT NEXT_PUBLIC_ on purpose —
# it is read at run time and passed to the browser as a prop, so the same
# build works on a host that configures it and a host that does not.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can complain to. Defaults to NEXT_PUBLIC_SITE_URL.
# VAPID_SUBJECT=mailto:you@example.com

# Demo control: adds a field to /account that pushes a typed message to EVERY
# subscribed device on this deployment, from any signed-in account. Meant for
# a presentation, and off unless this is exactly "1". Turn it off afterwards —
# the control and the capability go together.
# PUSH_BROADCAST_ENABLED=1

# Creating an account is switched off in lib/auth-gate.ts, and this is the way
# back in: set it and /register asks for an access key that has to match this
# string exactly (whitespace at either end is ignored). Leave it unset and
# sign-up stays closed. Signing IN is not gated either way. Server-side only —
# the page tells the form only *that* a key is required, never what it is.
# LOGIN_KEY=

# AI assistant (Google Gemini). Server-side only — the key never reaches the
# browser. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-pro-latest
# The fallback chain, tried in order when a model answers 503 (Gemini does
# that under load), 429, 5xx, or 404 — the last because Google retires model
# ids from under a running deployment. GEMINI_MODEL always leads, and the chat
# debug panel's dropdown picks which one starts.
# GEMINI_MODELS=gemini-pro-latest,gemini-3.6-flash,gemini-flash-latest,gemini-3.5-flash
# The model for the one call a person waits on, the savings-goal icon. Flash,
# because Flash is the one that can be told not to think at all.
# GEMINI_FAST_MODEL=gemini-flash-latest
# GEMINI_URL=https://generativelanguage.googleapis.com/v1beta
# Thinking tokens, budgeted ON TOP of MAX_TOKENS rather than out of it. Pro
# cannot go below 128; only a Flash model accepts 0.
# GEMINI_THINKING_BUDGET=2048

# What the customer actually reads — the visible answer's token budget.
MAX_TOKENS=1000
