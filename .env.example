# Copy to .env.local. Nothing here is required locally — every variable has a
# working default, except APERTUS_KEY, without which the assistant replies with
# a configuration hint instead of calling the API.

# SQLite file. On a container host, must point into a persistent volume.
DATABASE_PATH=./data/app.db

# Public origin, for Open Graph tags. Read at BUILD time.
NEXT_PUBLIC_SITE_URL=https://beyond-money.example.com

# Demo account `npm run seed` imports into, and where it reads .csv exports.
# A SEED_EMAIL you change must already exist — the seed will not create it.
# SEED_EMAIL=you@example.com
# SEED_NAME=Jeanine
# SEED_PASSWORD=something-only-you-know   # default is public; set on deploys
# SEED_DIR=./scripts/seed-data

# Where `npm run db:backup` writes. Default: `backups/` beside the database.
# BACKUP_DIR=./data/backups

# Web push notifications. Optional — without a keypair the account page's
# notification row says push is not configured and offers no button. Generate
# one with `npm run vapid`, then keep it: every subscription a browser hands
# out is bound to the public key it was created with, so a new pair silently
# unsubscribes every device. The public key is NOT NEXT_PUBLIC_ on purpose —
# it is read at run time and passed to the browser as a prop, so the same
# build works on a host that configures it and a host that does not.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can complain to. Defaults to NEXT_PUBLIC_SITE_URL.
# VAPID_SUBJECT=mailto:you@example.com

# Demo control: adds a field to /account that pushes a typed message to EVERY
# subscribed device on this deployment, from any signed-in account. Meant for
# a presentation, and off unless this is exactly "1". Turn it off afterwards —
# the control and the capability go together.
# PUSH_BROADCAST_ENABLED=1

# AI features (Apertus). Server-side only — no key ever reaches the browser.
# Used by the anomaly narrator and the savings-goal icon picker, and by the
# chat unless the CHAT_* variables below override it.
APERTUS_KEY=
APERTUS_URL=https://llm.stoney-cloud.com/v1/chat/completions
MODEL=apertus-ai/Apertus-v1.5-8B
MAX_TOKENS=1000

# The chat only, and optional — unset, it falls back to APERTUS_* above and
# nothing changes. Apertus 70B is the better model on the harder turns; both
# it and the 8B pass tests/assistant-eval.test.ts on the current tool set, so
# this is a lever, not a requirement.
# Do NOT point the shared MODEL at the 70B: the onprem.ai gateway mangles
# `response_format: json_object`, which the anomaly narrator and the icon
# picker both depend on.
CHAT_KEY=
CHAT_URL=https://llm-api2.b.onprem.ai/openai/v1/chat/completions
CHAT_MODEL=apertus-v1.5-70b
