# Copy to .env.local for development. None of these are required locally —
# every one has a working default.

# Where the SQLite file lives. On a container host this MUST point into a
# persistent volume, or every redeploy starts with an empty database.
# Default: ./data/app.db
DATABASE_PATH=./data/app.db

# The deployment's public origin, used as metadataBase for Open Graph tags.
# Without it, shared links advertise an image at http://localhost:3000 and
# render without a preview. Read at BUILD time — changing it needs a rebuild.
# Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://beyond-money.example.com

# Which account `npm run seed` imports the statements into. If you change this,
# the account must already exist — the seed will not create it under an email
# you chose, because it would also be choosing the password.
# Default: jeanine@example.com (the demo account, which the seed does create)
# SEED_EMAIL=you@example.com

# Password given to the demo account when the seed creates it. The default is
# hardcoded in scripts/seed.ts and therefore public — set this on any
# deployment you do not want the whole internet able to sign into.
# Default: beyond-money-demo
# SEED_PASSWORD=something-only-you-know

# Where `npm run seed` looks for .csv statement exports.
# Default: ./scripts/seed-data
# SEED_DIR=./scripts/seed-data

# Where `npm run db:backup` writes snapshots.
# Default: a `backups/` folder next to the database.
# BACKUP_DIR=./data/backups
